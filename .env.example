# Copy this file to .env and let the main Agent fill in the values.
# .env is local-only and must not be committed.

# ── Soundao 凭证 ──────────────────────────────────────────
# 没有 credentials？加入 QQ 群 1030846851 申请试用。
SOUNDAO_USER=
SOUNDAO_PASS=

# ── Agent 工作区 ──────────────────────────────────────────
# 留空则默认为源码同级的 Soundao_Agent_Workspace 目录
SOUNDAO_AGENT_WORKSPACE=

# ── 子 Agent 运行参数 ─────────────────────────────────────
# 子 Agent 使用的模型（provider/model 格式）
# 留空则使用 opencode 自身默认模型
# WEB_AGENT_OPENCODE_MODEL=zhipuai-coding-plan/glm-5.1

# 子 Agent 超时秒数
WEB_AGENT_OPENCODE_TIMEOUT_SEC=1500

# opencode run 附加参数（默认空，权限由 opencode.json 控制）
WEB_AGENT_OPENCODE_FLAGS=
