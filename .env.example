# Soundao Web Agent Framework Configuration
# Copy this file to .env and fill in your values.
# The main agent (WorkBuddy) will configure these at startup.

# ── Workspace ──────────────────────────────────────────────────
# The directory where Soundao agent stores working files.
# Defaults to <project_root>/Soundao_Agent_Workspace if not set.
SOUNDAO_WORKSPACE=

# ── Server ─────────────────────────────────────────────────────
# Host and port for the web bridge server.
SOUNDAO_HOST=127.0.0.1
SOUNDAO_PORT=8766

# ── Soundao Cloud API ──────────────────────────────────────────
# Soundao cloud API base URL.
SOUNDAO_BASE_URL=https://sd.daoson.work:8443

# Soundao credentials — use API key OR username/password.
# ⚠️ 没有凭证？加入 Soundao QQ 群申请试用：群号 1030846851
#    QQ群链接：https://qm.qq.com/q/Ig6CkJnu
# ⚠️ 临时凭证（sd_ 开头）不能直接使用，需先到平台激活为正式凭证。
SOUNDAO_API_KEY=
SOUNDAO_USER=
SOUNDAO_PASS=

# ── Agent Mode ─────────────────────────────────────────────────
# Set to 1 to use WorkBuddy as the agent (instead of Codex CLI).
WEB_AGENT_WORKBUDDY=1

# Set to 1 to allow shell commands from web actions.
WEB_AGENT_ALLOW_SHELL=1

# ── Agent Loop ─────────────────────────────────────────────────
# Polling interval in seconds for agent_loop.py.
SOUNDAO_LOOP_INTERVAL=3

# Working directory for shell actions (defaults to project root).
SOUNDAO_CWD=
